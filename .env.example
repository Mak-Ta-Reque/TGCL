# XL-VLMs full pipeline environment template
# Source of truth: scripts/run_full_pipeline.py (PipelineConfig).
#
# Usage:
# 1) cp .env.example .env
# 2) Edit values in .env
# 3) Run: python scripts/run_full_pipeline.py
#
# Notes:
# - This file keeps "export" to remain shell-friendly.
# - run_full_pipeline.py loads .env using python-dotenv, so plain KEY=VALUE also works.
# - Keep paths absolute or ROOT_DIR-relative when running from shell wrappers.
# - Values below mirror a known-working AU-AIR run, so `cp .env.example .env`
#   needs the fewest possible edits (mainly HF_TOKEN -- see below). Swap the
#   commented-out coco10 alternatives back in if you're running that dataset
#   instead.

# ======================
# Required / Common
# ======================

# Step 1/2/3 input image root: a flat pool of images (or one-subfolder-per-tag,
# for CROP_MODE=none) that dataset_inference/crops_to_json read from.
export INPUT_DIR=data/auair/train_all
#export INPUT_DIR=data/coco10/train_all

# Root output directory for all step artifacts (features/concepts/explanations/
# eval/plots each get their own subfolder here -- see README.md's "Output
# layout"). Reused as-is on re-run: finished steps are skip-checked, not redone.
export OUTPUT_DIR="outputs/auair_run"
#export OUTPUT_DIR="outputs/tgcl_run"

# Hugging Face cache directory used by subprocesses. Per this project's disk
# convention (see CLAUDE.md), model/dataset downloads must not land under
# /home -- point this at the NVME mount.
export HF_HOME=/media/NVME_8TB/abka03/hfcache

# Same disk convention applies to every other cache a library in this
# pipeline might default to $HOME for -- nltk (used transitively by
# src/metrics/), torch's own hub cache, matplotlib's config dir, and pip's
# download cache. None of these are read by run_full_pipeline.py itself, but
# without them set, a fresh env's first nltk/torch/matplotlib/pip call
# writes straight to /home instead of the NVME mount.
export NLTK_DATA=/media/NVME_8TB/abka03/nltk_data
export TORCH_HOME=/media/NVME_8TB/abka03/torch_home
export MPLCONFIGDIR=/media/NVME_8TB/abka03/mpl_config
export PIP_CACHE_DIR=/media/NVME_8TB/abka03/pip_cache

# Optional Hugging Face auth token for gated/private models (e.g. some Llama
# checkpoints). Get your own at https://huggingface.co/settings/tokens --
# NEVER put a real token in this file (.env.example is committed to git);
# set it in your own .env instead, which is gitignored.
# export HF_TOKEN=""
# Optional alias used by some helper scripts
# export HUGGINGFACE_HUB_TOKEN="$HF_TOKEN"

# Step 5 image source for the explainer (defaults to INPUT_DIR/grids if unset).
# Point this at a per-class single-object layout (data/auair/val/<class>/) if
# you want the object-classification F1 metric to work -- multi-object grid
# images can't be scored per-quadrant.
export IMAGE_ROOT=data/auair/val
#export IMAGE_ROOT=data/coco10/val

# Model and runtime
# VLM_MODEL: any of the classes in src/models/ (llava-1.5, Qwen2/2.5-VL,
# idefics2, Molmo, CheXagent, gemma-3) -- see src/models/__init__.py's
# get_model_class() for the exact match rules.
export VLM_MODEL="Qwen/Qwen2.5-VL-7B-Instruct"
#export VLM_MODEL="Qwen/Qwen2.5-VL-3B-Instruct"
#export VLM_MODEL="google/gemma-3n-E4B-it"
# BATCH_SIZE: images per forward pass in steps 1/3/4/6. Lower this first if
# you hit CUDA out of memory; 16 is comfortable for a 7B model on a 24GB GPU.
export BATCH_SIZE=16
export SEED=42
# Device selection (parsed by src/device_utils.py):
#   "cuda:1"    single GPU 1        "cuda:0,2" / "cuda:[0,2]"  multi-GPU shard
#   "auto"      all available GPUs  "cpu"                      CPU only
# DEVICE_ID=<n> works as a fallback alias when DEVICE is unset.
export DEVICE="cuda:0"
#export DEVICE="cuda:0,1"   # multi-GPU example

# CUDA allocator tuning — see PyTorch Memory Management docs:
# https://docs.pytorch.org/docs/stable/notes/cuda.html#optimizing-memory-usage-with-pytorch-cuda-alloc-conf
# The pipeline sets expandable_segments:True by default (reduces
# fragmentation-driven OOMs); uncomment to override or tune further.
#export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
#export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True,max_split_size_mb:128"

# ======================
# Step 2: crops_to_json
# ======================

# Crop mode: random | sliding_window | sam3 | langsam
# random/sliding_window => detector disabled (no extra install needed)
# sam3/langsam         => detector enabled (see README.md's install section)
export CROP_MODE="sliding_window"

# Concept frequency filtering prior to crop generation: a tag needs at least
# MIN_IMAGES_PER_TAG images to reach feature extraction at all (too few and
# there's no signal to decompose); MAX_IMAGES_PER_TAG caps how many of a very
# common tag's images actually get used, to keep per-tag cost bounded.
export MIN_IMAGES_PER_TAG=2
export MAX_IMAGES_PER_TAG=128

# --------------------------------------
# Random/Sliding-window mode variables
# Applies when CROP_MODE=random or sliding_window
# --------------------------------------

# Number of masks/windows generated per image
export MASKS_PER_IMAGE=5

# Number of crops retained per (concept, image)
export CONCEPT_MASKS_PER_IMAGE=1

# Patch/window size for random and sliding-window modes
export PATCH_SIZE=200

# --------------------------------------
# Detector mode variables
# Applies when CROP_MODE=sam3 or langsam
# --------------------------------------

# Detector batch size
export DETECTION_BATCH_SIZE=2

# Detector confidence threshold; use -1 for adaptive midpoint cutoff
export SEGMENTATION_CONFIDENCE=-1

# Segmentation controls
# 0 = multi-mask behavior
# 1 = positive/negative binary mask behavior
export POSITIVE_NEGATIVE_SEGMENT=0

# Foreground/background masking setup
# Supported methods: gaussian_blur | ns | telea | noisy_linear | blackout
export INPAINTING_METHOD="gaussian_blur"
export INPAINTING_METHOD_BG="gaussian_blur"
export MASK_BLUR_RADIUS=15
export MASK_BLUR_RADIUS_BG=15
export MASK_CONTEXT_PIXELS=0
export MASK_BOUNDARY_PIXELS=0

# Vision-token masking (alternative to the pixel crop/blur pipeline above):
# pass the FULL image to the VLM and zero out the vision-encoder output
# tokens whose image patch lies outside the crop bbox / segmentation mask.
# Applies to save_features; when enabled, INPAINTING_METHOD / MASK_BLUR_RADIUS
# and PATCH_SIZE resizing are bypassed (MASK_CONTEXT_PIXELS still dilates fg /
# erodes bg masks). Supported for Qwen2.5-VL-style vision towers.
export VISION_TOKEN_MASKING=0
# Minimum fraction of a vision token's patch that must be inside the mask
# for the token to be kept (0..1).
export VISION_TOKEN_MASK_THRESHOLD=0.5
# Optional explicit module name of the vision tower; auto-detected by default
# (modules named visual / vision_tower / vision_model).
# export VISION_TOKEN_MASK_MODULE="model.visual"

# ======================
# Step 1: dataset_inference
# ======================

# Prompt used to produce concept/object strings per image. The vocab-priming
# clause below tells the model which literal word to use for the categories
# CONCEPTS_VOCAB cares about (AU-AIR's 8 classes) -- without it, the model's
# preferred synonym (e.g. "person" for "human", "motorcycle" for "motorbike")
# would never match the vocab filter and that tag would get near-zero images.
# Swap the class list if you change CONCEPTS_VOCAB / EXPL_CHOICES below.
export PROMPT="Identify every visible object, item, concept, and pattern in the image at the most fine-grained level. If you see any of the following, use exactly this word for it: human, car, truck, van, motorbike, bicycle, bus, trailer. For anything else, use its most natural single word. Output only single words in a strict comma-separated list, no sentences or explanations."
#export PROMPT="Identify every visible object, item, concept, and pattern in the image at the most fine-grained level. Output only single words in a strict comma-separated list, no sentences or explanations."

# Prompt template forwarded to feature extraction stack. "tgcl" sends a
# contrastive "Classify as [concept] or No [concept]" prompt per tag (see
# README.md's "What tgcl is"); other values: non_contrastive, null, yn.
export PROMPT_TEMPLATE=tgcl

# Resize reference width (height is derived by aspect ratio in code)
export IMAGE_SIZE_WIDTH=512

# Kept for compatibility/debug logging in pipeline config
export IMAGE_SIZE_HEIGHT=512

# Max images considered in step 1
# Use -1 for no limit
export IMAGE_BUDGET=2000

# ======================
# Step 3/4: features + decomposition
# ======================

# Decomposition methods, comma-separated (example: snmf,nmf,pca)
export DECOMP_METHODS="snmf"

# Number of decomposed concept components
export DECOMP_COMPONENTS=2

# Sparsity regularization strength for decomposition, higher = sparser.
# DL_ALPHA: L1 alpha for SNMF/dictionary-learning methods (snmf, nndl). Default 20.
# SAE_SPARSITY_LAMBDA: L1 penalty weight on the SAE hidden code (sae, sae2). Default 0.0005.
# Try e.g. 1.0 on either for a much sparser decomposition.
export DL_ALPHA=20
export SAE_SPARSITY_LAMBDA=0.0005

# Optional hard top-k activation for sae/sae2: guarantees this exact fraction
# of zero entries in the SAE code (e.g. 0.99), unlike SAE_SPARSITY_LAMBDA which
# plateaus well short of high targets. Leave empty/commented out to disable
# (soft L1 penalty only, via SAE_SPARSITY_LAMBDA above).
# export SAE_TARGET_SPARSITY=0.99

# Top-N concepts by crop count to keep from concept map
# -1 means keep all concepts
export NUM_CONCEPT=-1

# Optional vocab filter applied before the top-N selection: one concept name
# per line. Leave unset/commented to select the top-N most frequent tags
# without any vocab filtering. Must stay in sync with the PROMPT's class list
# and EXPL_CHOICES below -- they all describe the same category set.
export CONCEPTS_VOCAB=src/assets/auair_vocab.txt
#export CONCEPTS_VOCAB=src/assets/coco10_vocab.txt

# Bags/samples consumed by save_features: an upper bound on how many crops a
# single feature-extraction batch draws from crops.json. Raise this if a
# common tag's crops are getting truncated before reaching decomposition.
export BAG_SIZE=900

# 1 => remove intermediate decomposition files where supported
export DELETE_INTERMEDIATE_FILES=0

# Hook/module path used for feature extraction and regrounding
export LAYER_PATH="model.language_model.norm"

# --- Per-tag layer selection via logit lens (step 3) ---
# 1 => before extracting each tag's features, sweep decoder layers with the
# logit lens on that tag's own regions from crops.json (step 2 bbox/mask
# patches, preprocessed exactly like extraction) and hook the layer whose
# relative probability p(tag)/p(top-1 token) is highest. LAYER_PATH becomes
# the fallback. The chosen layer is stored as `selected_layer` in the feature
# .pth, in the decomposition output, and in the combined concept bank.
# Intermediates (per-layer scores, plots) go to <OUTPUT_DIR>/logitlens/<tag>/.
export LOGIT_LENS_LAYER_SELECTION=0
# "patch" => score visual-token positions of one forward pass (image patches);
# "text"  => score the answer-producing positions of a full generation.
export LOGIT_LENS_MODE="patch"
# Layers to sweep: "auto" (all language-model decoder layers), a range
# "0-27", a list "5,10,20", or full dotted module paths.
export LOGIT_LENS_LAYERS="auto"
# How many crops.json regions to probe per tag (uniform sample).
export LOGIT_LENS_NUM_PATCHES=8

# ======================
# Step 5/6: explain + eval
# ======================

# Top concepts explained per sample
export TOP_N=3

# Positive/negative concept split threshold. A direction is POSITIVE when its
# positive ratio >= this threshold; below it the direction is kept in the
# negative bank instead of being discarded. The ratio is embedded in the bank
# file names (combined_concept_<method>_cr<ratio>_raw.pth and
# combined_negative_concept_<method>_cr<ratio>_*) for side-by-side evaluation.
# Lower this if most/all directions are landing in the negative bank (0.5 is
# already relaxed from the 0.8 default) -- but note a direction with a flat
# 0.0 ratio has no clean signal at any threshold; that's a crop-isolation
# problem, not something a lower CLEAN_EXAMPLE_RATIO fixes.
export CLEAN_EXAMPLE_RATIO=0.5
# Which ratio the split uses (both are always computed and stored per concept):
#   assigned (default) — positives among argmax-assigned samples / #assigned
#   weighted           — positive activation mass / total mass (margin-aware)
#   both               — must pass the threshold on BOTH metrics
#export DIRECTION_RATIO_MODE=assigned
# Require at least N assigned samples for a direction to become positive
# (guards against tiny high-variance sets). Default 1 = off.
#export MIN_DIRECTION_ASSIGNED=3

# Number of most activating samples selected per concept for image grounding.
# Most-activating samples kept per concept in the image grounding.
# -1 = keep ALL samples (still ordered by activation, strongest first).
export NUM_MOST_ACTIVATING_SAMPLES=5

# Number of insertion/deletion points for token curves
export NUM_POINTS=70

# Prompt mode used by inference/vlm_explainer_multibatch.py
# Typical values: unsupervised | supervised | mcq (depends on script support)
export EXPL_PROMPT_MODE="mcq"

# Choices for EXPL_PROMPT_MODE=mcq (or supervised): the explainer picks one
# label per image from exactly this list. Keep in sync with CONCEPTS_VOCAB
# and PROMPT above -- all three describe the same category set.
export EXPL_CHOICES="human,car,truck,van,motorbike,bicycle,bus,trailer"
#export EXPL_CHOICES="apple,banana,bird,cake,cat,cup,dog,donut,knife,orange"

# Images the explainer takes from IMAGE_ROOT:
#   -1 = all (the explainer recursively collects every image under IMAGE_ROOT)
#   0  = no explanation (skips step 6; eval/plots are skipped too)
#   N  = first N images
# CAUTION: images are collected in directory-walk (effectively alphabetical)
# order, not sampled -- a small N here means evaluation only ever sees the
# first class alphabetically, silently skewing any accuracy/F1 you compute.
# Use -1 (or a value >= your full val set) unless you specifically want a
# fast, non-representative smoke test.
export EXPL_MAX_IMAGES=10

# Optional label/choices for supervised or multiple-choice prompting
# export EXPL_LABEL="tiger"

# ======================
# Step 7: plotting
# ======================

# Shared y-axis range for token curve plots and method summaries
export PLOT_YMIN=6.55e-6
export PLOT_YMAX=7.10e-6

# ======================
# Optional behavior toggles
# ======================

# Step 3 re-run behavior:
# - In pipeline code, if unset this is treated as 1 (debug mode on).
# - 1 forces Step 3 recompute even when feature .pth files already exist.
# - 0 allows Step 3 to skip when features already exist.
# With cascade logic enabled in pipeline, recomputing Step 3 will invalidate
# downstream Step 4-7 artifacts automatically.
# export DEBUG_SAVE_VLM_INPUTS=0

# Optional tokenizer/runtime controls (generally not required)
# export TORCH_COMPILE_DISABLE=1
# export PYTHONHASHSEED=42

# ======================
# Optional vars used by other scripts in this repo
# (demo/, eval/, legacy helpers)
# ======================

# Device overrides for CLIP/BERT based scoring scripts
# export BERT_DEVICE="cuda"
# export CLIP_DEVICE="cuda"

# Standalone eval helpers (non-pipeline) may use these path selectors
# export ROOT_DIR="$ROOT_DIR"
# export DECOMP_METHOD="snmf"
# export ALPHA_ROOT="$ROOT_DIR/outputs/run_example"

# Optional crop-generation knobs used by preprocessing/crops_to_json.py
# export RLE=1
# export CLIP_SIMILARITY_THRESHOLD=0.5
# export SLIDING_WINDOW_STRIDE_RATIO=0.3  # sliding_window mode: window is PATCH_SIZE x PATCH_SIZE; stride as fraction of PATCH_SIZE
# export CROP_PER_IMAGE=0
# export BIG_AREA_RATIO=0.5  # semantic masks above this fraction of image area are skipped

# Demo/API scripts
# export CONCEPT_PATH="$ROOT_DIR/outputs/run_example/concept/snmf/combined_concept_snmf_raw.pth"
# export DISPLAY_W=500
# export FIXED_INSTRUCTION="Describe the image briefly. "
# export CLASSIFY_API_DOWNSAMPLE_RATIO=1.0
# export CLASSIFY_API_MAX_LONG_EDGE=512
# export GROUND_BBOX_COORD_SPACE="processed"
# export CLASSIFY_API_PORT=8501
# export DATA_ROOT_REMAP=""

# Legacy/compat vars referenced in older scripts
# export CONCEPT_DETECTOR="langsam"

# ======================
# Optional presets (examples)
# ======================

# Fast local smoke run
# export IMAGE_BUDGET=30
# export BATCH_SIZE=4
# export TOP_N=2
# export NUM_POINTS=20
# export MIN_IMAGES_PER_TAG=3
# export MAX_IMAGES_PER_TAG=10

# Full quality run
# export IMAGE_BUDGET=-1
# export BATCH_SIZE=48
# export TOP_N=5
# export NUM_POINTS=70
# export MIN_IMAGES_PER_TAG=20
# export MAX_IMAGES_PER_TAG=256

# ======================
# Legacy names (do not use)
# ======================

# Deprecated / not read by current run_full_pipeline.py:
# - MAX_OVERLAP
# - PATCHES_PER_IMAGE           (use MASKS_PER_IMAGE)
# - CONCEPT_CROPS_PER_IMAGE    (use CONCEPT_MASKS_PER_IMAGE)
# - DATASET_SIZE               (use BAG_SIZE)
# - DEVICE_ID                  (use DEVICE, e.g., cuda:0)
# - POSITIVE_NEGATVE_SEGMENT   (typo alias; use POSITIVE_NEGATIVE_SEGMENT)
# - IMPAINING_METHOD           (typo alias; use INPAINTING_METHOD)

# AI API keys audit:
# - No OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY usage found in
#   the active Python/Shell pipeline code.
